name = "moonbitgis/supercluster"

version = "0.1.0"

description = "MoonBit port of mapbox/supercluster: fast geospatial point clustering based on a zoom-level hierarchy of KD-trees, for WebGIS (Wasm/JS bindings ready)."

readme = "README.md"

repository = "https://gitee.com/YWNdesign/moonbit-supercluster"

license = "BSD-2-Clause"

keywords = [
  "gis",
  "webgis",
  "cluster",
  "clustering",
  "geojson",
  "map",
  "supercluster",
  "kdbush",
]
